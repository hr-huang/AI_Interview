# ==============================================
# Qwen3.8 Max 配置（阿里云百炼 OpenAI-compatible API）
# ==============================================
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
QWEN_TIMEOUT=600

# ==============================================
# SiliconFlow BGE-M3 Embedding 配置
# ==============================================
SILICONFLOW_API_KEY=
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# ==============================================
# LLM 通用参数
# ==============================================
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_TOP_P=0.95
# 所有模型 prompt、结构化响应和解析错误追加到同一个 JSONL 文件；不会记录 API Key。
LLM_TRACE_PATH=artifacts/calibration/llm-traces.jsonl

# ==============================================
# 后续 Adaptive Interview 预留
# 当前 Pre-Interview 阶段暂未消费这些配置
# ==============================================
AGENT_DEBUG=true
AGENT_MAX_ITER=10
